{
  "testCaseId": "BSSRA-TC-001",
  "title": "Recon File Generator->Verify Configuration Name Field",
  "objective": "This test case is used to verify configuration name. Underscore (_) shall be allowed. The value must be unique and editable.",
  "description": "",
  "project": "BSSRA",
  "module": "System Configuration",
