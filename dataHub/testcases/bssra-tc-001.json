  "estimatedTime": "",
  "steps": [
    {
      "action": "Go to System configuration-> Recon file generator\n",
      "testData": "",
      "expectedResult": "Recon file generator list page should appear"
    },
    {
      "action": "Click on “+” icon\n",
      "testData": "",
      "expectedResult": "Recon file generator Master page should appear"
    },
    {
      "action": "Enter configuration name with underscore .",
      "testData": "(e.g., Recon_Test_01)",
      "expectedResult": "System should accept underscore (_)"
    },
    {
      "action": "Enter duplicate configuration name",
      "testData": "",
      "expectedResult": "System should show validation error for duplicate value"
    },
    {
      "action": "Edit configuration name",
      "testData": "",
      "expectedResult": "Field should be editable"
    },
    {
      "action": "Click on info icon\n",
      "testData": "",
      "expectedResult": "Backend filename pattern should be displayed"
    }
  ],
